# ==============================================================================
# siZa Environment Configuration
# Copy this file to .env.local and replace every placeholder with your actual values.
# NEVER commit .env.local, .env, or real production secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Prototype & Application Mode
# ------------------------------------------------------------------------------
# Set ALLOW_PROTOTYPE_ROUTES=true only during local rapid prototyping
ALLOW_PROTOTYPE_ROUTES=false
# Mode: "prototype" (in development) or "production"
NEXT_PUBLIC_APP_MODE=prototype

# ------------------------------------------------------------------------------
# 2. Supabase Backend (Database, Auth & Storage)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. Security & Cryptography Keys
# ------------------------------------------------------------------------------
# 32-byte AES-256 key, base64-encoded. Used for encrypting ID documents & bank details.
# Generate in PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
# Or in Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ID_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# Secret token required to trigger scheduled retention cron jobs (min 32 characters)
MAINTENANCE_JOB_SECRET=your-random-32-char-maintenance-secret

# ------------------------------------------------------------------------------
# 4. Email Service (Resend)
# ------------------------------------------------------------------------------
# API Key from Resend dashboard (https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
# Sender identity (must match a verified domain in Resend)
RESEND_FROM_EMAIL=siZa <notifications@siza.co.za>

# Admin email where critical reports, fraud alerts, and no-shows are emailed
ADMIN_NOTIFY_EMAIL=admin@siza.co.za

# ------------------------------------------------------------------------------
# 5. Cloudflare Turnstile (Bot & Anti-Abuse Protection)
# ------------------------------------------------------------------------------
# Keys from Cloudflare Dashboard -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ------------------------------------------------------------------------------
# 6. Public Assets & Social Channels
# ------------------------------------------------------------------------------
# WhatsApp helper community invite link
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/your-group-invite


# ==============================================================================
# Phase B Marketplace Additions
# (When absent, the platform automatically runs on local mock adapters)
# ==============================================================================

# ------------------------------------------------------------------------------
# 7. Paystack Payments (South Africa)
# ------------------------------------------------------------------------------
# Obtain from Paystack Dashboard -> Settings -> API Keys & Webhooks
# Use test keys (sk_test_..., pk_test_...) for staging/dev; live keys for production.
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Webhook signature secret configured in Paystack to verify server-to-server callbacks
# Set your Paystack Webhook URL to: https://your-domain.com/api/webhooks/paystack
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ------------------------------------------------------------------------------
# 8. KYC & Biometric Identity Verification (Smile ID / DHA)
# ------------------------------------------------------------------------------
# Optional: If unset, helper KYC falls back to the internal mock/manual verification flow.
# Obtain from Smile ID Portal (https://portal.usesmileid.com)
SMILE_ID_PARTNER_ID=your_smile_id_partner_id
SMILE_ID_API_KEY=your_smile_id_api_key
# 0 = Sandbox server, 1 = Production server
SMILE_ID_SID_SERVER=0

# ------------------------------------------------------------------------------
# 9. WhatsApp Business Cloud API (Optional automated messages)
# ------------------------------------------------------------------------------
# If unset, helpers use the direct one-tap "wa.me" deep links with prefilled ETA text.
WHATSAPP_TOKEN=your_meta_whatsapp_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id