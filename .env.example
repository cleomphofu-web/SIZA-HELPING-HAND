# SIZA environment variables
# Copy this file to .env.local and replace every placeholder.
# Never commit .env.local or real secrets.

# Prototype safety
ALLOW_PROTOTYPE_ROUTES=false
NEXT_PUBLIC_APP_MODE=prototype

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=SIZA <onboarding@resend.dev>

# 32-byte AES-256 key, base64-encoded. Generate a unique production value.
ID_ENCRYPTION_KEY=base64-encoded-32-byte-key

# WhatsApp
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/your-group-invite

# Admin notifications
ADMIN_NOTIFY_EMAIL=admin@example.com

# Optional internal maintenance job auth. Leave unset until a scheduler is configured.
# MAINTENANCE_JOB_SECRET must contain at least 32 characters; never commit its value.

# Cloudflare Turnstile
# Configure these when SIZA has a domain registered in Cloudflare.
# Until then, leave the placeholders in place and use a local/test strategy only.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Hero video and supplied brand assets
NEXT_PUBLIC_HERO_VIDEO_ID=your-youtube-video-id
